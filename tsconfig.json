{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true, "skipLibCheck": true, "esModuleInterop": true,
    "allowSyntheticDefaultImports": true, "strict": true, "module": "ESNext",
    "moduleResolution": "Bundler", "types": ["vite/client"], "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "isolatedModules": true, "noEmit": true, "jsx": "react-jsx"
  },
  "include": ["src", "vite.config.ts"]
}
